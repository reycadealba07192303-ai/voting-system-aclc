PORT=5000
# Prefer authenticated Mongo in production, e.g.:
# MONGO_URI=mongodb://appUser:STRONG_PASSWORD@localhost:27017/ssg_election?authSource=admin
MONGO_URI=mongodb://localhost:27017/ssg_election
# Use a long random secret (32+ chars). Never commit the real value.
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
# Prefer short-lived tokens (2–4 hours)
JWT_EXPIRES_IN=4h
# Comma-separated browser origins for admin-web (mobile apps often send no Origin)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Set to false in production to lock down new admin signups
ALLOW_ADMIN_REGISTER=true
