VITE_API_URL=http://localhost:5000/api
# The student portal is built into public/student/ by `npm run student:build`
# and served from this same host. Set this only if you host it separately:
# VITE_STUDENT_APP_URL=http://localhost:8080/#/


# Para sa local development lang ang file na ito. Ang deployed site ay kumukuha
# ng URL nito sa .env.production, na binabasa lang ni Vite sa `vite build`.
