# Binabasa lang ito ni Vite sa `vite build` (production), hindi sa `npm run dev`.
# Kaya tumuturo ang deployed site sa Render habang nananatili sa localhost
# ang local development mo.
#
# Ligtas itong i-commit: pampublikong URL lang ito, walang credential.
# Naka-bake sa JS bundle ang lahat ng VITE_* var, kaya nakikita ng browser —
# kailanman huwag maglagay ng sikreto rito.
VITE_API_URL=https://voting-system-aclc-4xo6.onrender.com/api
