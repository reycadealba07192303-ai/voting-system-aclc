# Production .env for the backend — copy to /opt/voting/app/backend/.env on the
# server and fill in the real values. Never commit the filled-in copy.
#   chmod 600 /opt/voting/app/backend/.env
#   chown voting:voting /opt/voting/app/backend/.env

PORT=5000

# NODE_ENV is set by the systemd unit, but keep it here too so a manual
# `node server.js` does not accidentally run in development mode. That matters:
# outside production the CORS layer also accepts any private-LAN origin.
NODE_ENV=production

# MongoDB Atlas connection string. Percent-encode any of @ : / ? # [ ] % that
# appear in the password, otherwise the URI will not parse.
# deploy.sh and backup.sh both read this file, so keep it the single source.
MONGO_URI=mongodb+srv://votingApp:REPLACE_WITH_DB_PASSWORD@cluster0.xxxxx.mongodb.net/ssg_election?retryWrites=true&w=majority

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_EXPIRES_IN=4h

# Exactly the public origin, no trailing slash. Everything is same-origin
# behind nginx, so one entry is enough.
ALLOWED_ORIGINS=https://ssgvote.duckdns.org

# Lock this down once the real admin accounts exist, otherwise anyone who can
# reach /api/auth/register can mint an admin.
ALLOW_ADMIN_REGISTER=false
